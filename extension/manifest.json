{
  "manifest_version": 3,
  "name": "Kite Pattern Radar",
  "version": "1.0.0",
  "description": "Non-invasive live stream pattern detector for Zerodha Kite. Computes candlestick & momentum patterns locally in browser.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://kite.zerodha.com/*",
    "http://*/*",
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kite Pattern Radar Status"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://kite.zerodha.com/*"
      ],
      "all_frames": true,
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "app_bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
